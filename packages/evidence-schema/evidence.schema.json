{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/evidence/evidence.schema.json",
  "title": "CCI Evidence",
  "oneOf": [
    {"$ref": "#/$defs/Evidence"},
    {"$ref": "#/$defs/RawExtractionEvidence"}
  ],
  "$defs": {
    "Evidence": {"type": "object", "required": ["evidence_id", "document_id", "source", "confidence"], "properties": {"evidence_id": {"type": "string"}, "document_id": {"type": "string"}, "template_id": {"type": ["string", "null"]}, "template_version": {"type": ["integer", "null"], "minimum": 1}, "rule_id": {"type": ["string", "null"]}, "source_text": {"type": ["string", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "source": {"oneOf": [{"$ref": "#/$defs/PdfEvidence"}, {"$ref": "#/$defs/ExcelEvidence"}]}}, "additionalProperties": false},
    "BoundingBox": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "PdfEvidence": {"type": "object", "required": ["kind", "page"], "properties": {"kind": {"const": "pdf"}, "page": {"type": "integer", "minimum": 1}, "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]}}, "additionalProperties": false},
    "ExcelEvidence": {"type": "object", "required": ["kind", "sheet", "cell_range"], "properties": {"kind": {"const": "excel"}, "sheet": {"type": "string"}, "cell_range": {"type": "string"}}, "additionalProperties": false},
    "SourceReference": {"type": "object", "required": ["document_id"], "properties": {"document_id": {"type": "string"}, "preview_id": {"type": ["string", "null"]}, "storage_bucket": {"type": ["string", "null"]}, "storage_key": {"type": ["string", "null"]}, "page": {"type": ["integer", "null"], "minimum": 1}, "sheet": {"type": ["string", "null"]}, "cell_range": {"type": ["string", "null"]}, "bbox": {"anyOf": [{"$ref": "#/$defs/BoundingBox"}, {"type": "null"}]}}, "additionalProperties": false},
    "TemplateRuleReference": {"type": "object", "required": ["template_id", "template_version_id"], "properties": {"template_id": {"type": "string"}, "template_version_id": {"type": "string"}, "field_id": {"type": ["string", "null"]}, "extraction_rule_id": {"type": ["string", "null"]}}, "additionalProperties": false},
    "RawExtractionEvidence": {"type": "object", "required": ["evidence_id", "extraction_job_id", "source"], "properties": {"evidence_id": {"type": "string"}, "extraction_job_id": {"type": "string"}, "source": {"$ref": "#/$defs/SourceReference"}, "template_rule": {"anyOf": [{"$ref": "#/$defs/TemplateRuleReference"}, {"type": "null"}]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "raw_text": {"type": ["string", "null"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
