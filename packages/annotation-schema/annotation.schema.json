{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/annotations/annotation.schema.json",
  "title": "CCI Template Annotation",
  "type": "object",
  "required": ["id", "template_id", "document_id", "field_id", "annotation_type", "selection_payload"],
  "properties": {
    "id": {"type": "string"},
    "template_id": {"type": "string"},
    "template_version_id": {"type": ["string", "null"]},
    "document_id": {"type": "string"},
    "field_id": {"type": "string"},
    "annotation_type": {"type": "string", "enum": ["pdf_text_block", "pdf_line", "pdf_token", "pdf_area", "pdf_table_candidate", "excel_cell", "excel_column", "excel_row", "excel_range", "excel_table_candidate"]},
    "source_preview_id": {"type": ["string", "null"]},
    "selected_text": {"type": ["string", "null"]},
    "selection_payload": {"type": "object"}
  },
  "$defs": {
    "CreateAnnotationRequest": {
      "type": "object",
      "required": ["field_id", "document_id", "annotation_type", "selection_payload"],
      "properties": {
        "template_version_id": {"type": ["string", "null"]},
        "field_id": {"type": "string"},
        "document_id": {"type": "string"},
        "annotation_type": {"type": "string", "enum": ["pdf_text_block", "pdf_line", "pdf_token", "pdf_area", "pdf_table_candidate", "excel_cell", "excel_column", "excel_row", "excel_range", "excel_table_candidate"]},
        "source_preview_id": {"type": ["string", "null"]},
        "selected_text": {"type": ["string", "null"]},
        "selection_payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "CreateAnnotationWithRuleRequest": {
      "allOf": [
        {"$ref": "#/$defs/CreateAnnotationRequest"},
        {
          "type": "object",
          "properties": {
            "generate_rule": {"type": "boolean"},
            "rule_strategy": {"type": ["string", "null"]},
            "rule_config": {"type": ["object", "null"]}
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
