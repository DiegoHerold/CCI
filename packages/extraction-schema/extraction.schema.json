{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/extractions/extraction.schema.json",
  "title": "CCI Extraction Contracts",
  "oneOf": [
    { "$ref": "#/$defs/ExtractionJob" },
    { "$ref": "#/$defs/ExtractorWorkerInput" },
    { "$ref": "#/$defs/ExtractorWorkerOutput" },
    { "$ref": "#/$defs/ExtractionResult" }
  ],
  "$defs": {
    "ExtractionJobStatus": {
      "type": "string",
      "enum": ["pending", "queued", "starting", "running", "waiting_worker", "worker_running", "completed", "failed", "cancelled", "retrying", "requires_review"]
    },
    "ExtractionJob": {
      "type": "object",
      "required": ["extraction_job_id", "document_id", "client_id", "competence_id", "template_id", "template_version_id", "file_format", "status", "attempt_count", "max_attempts"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version_id": { "type": "string" },
        "matching_run_id": { "type": ["string", "null"] },
        "file_format": { "type": "string" },
        "status": { "$ref": "#/$defs/ExtractionJobStatus" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "workflow_id": { "type": ["string", "null"] },
        "workflow_run_id": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionRequest": {
      "type": "object",
      "properties": {
        "force_reprocess": { "type": "boolean", "default": false },
        "matching_run_id": { "type": ["string", "null"] },
        "template_id": { "type": ["string", "null"] },
        "template_version_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionAttempt": {
      "type": "object",
      "required": ["attempt_id", "extraction_job_id", "attempt_number", "status"],
      "properties": {
        "attempt_id": { "type": "string" },
        "extraction_job_id": { "type": "string" },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "worker_type": { "type": ["string", "null"] },
        "worker_name": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionArtifact": {
      "type": "object",
      "required": ["artifact_id", "extraction_job_id", "document_id", "artifact_type", "storage_bucket", "storage_key"],
      "properties": {
        "artifact_id": { "type": "string" },
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "artifact_type": { "type": "string", "enum": ["worker_raw_output", "workflow_log", "debug_payload"] },
        "storage_bucket": { "type": "string" },
        "storage_key": { "type": "string" },
        "content_hash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionWorkflowInput": {
      "type": "object",
      "required": ["extraction_job_id", "document_id", "client_id", "competence_id", "template_id", "template_version_id", "file_format"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version_id": { "type": "string" },
        "file_format": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ExtractionWorkflowOutput": {
      "type": "object",
      "required": ["extraction_job_id", "status"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "status": { "$ref": "#/$defs/ExtractionJobStatus" },
        "artifact_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractorWorkerInput": {
      "type": "object",
      "required": ["extraction_job_id", "document", "preview", "template"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "document": {
          "type": "object",
          "required": ["document_id", "file_format"],
          "properties": {
            "document_id": { "type": "string" },
            "file_format": { "type": "string" },
            "storage_bucket": { "type": ["string", "null"] },
            "storage_key": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "preview": {
          "type": "object",
          "properties": {
            "preview_id": { "type": ["string", "null"] },
            "storage_bucket": { "type": ["string", "null"] },
            "storage_key": { "type": ["string", "null"] },
            "preview": { "type": ["object", "null"] }
          },
          "additionalProperties": false
        },
        "template": {
          "type": "object",
          "required": ["template_id", "template_version_id", "file_format", "fields", "extraction_rules"],
          "properties": {
            "template_id": { "type": "string" },
            "template_version_id": { "type": "string" },
            "file_format": { "type": "string" },
            "fields": { "type": "array", "items": { "type": "object" } },
            "extraction_rules": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ExtractorWorkerOutput": {
      "type": "object",
      "required": ["extraction_job_id", "status", "raw_output", "warnings", "errors"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "failed", "requires_review"] },
        "raw_output": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ExtractionError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ExtractionRetryPolicy": {
      "type": "object",
      "required": ["max_attempts", "initial_interval_seconds", "backoff_coefficient", "max_interval_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "initial_interval_seconds": { "type": "integer", "minimum": 1 },
        "backoff_coefficient": { "type": "number", "minimum": 1 },
        "max_interval_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "ExtractedFieldValue": {
      "type": "object",
      "required": ["path", "raw_value", "normalized_value", "value_type", "confidence", "evidence_ids"],
      "properties": {
        "path": { "type": "string" },
        "raw_value": true,
        "normalized_value": true,
        "value_type": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "ExtractedObject": {
      "type": "object",
      "required": ["object_path", "fields"],
      "properties": {
        "object_path": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ExtractedFieldValue" } }
      },
      "additionalProperties": false
    },
    "ExtractionResult": {
      "type": "object",
      "required": ["job_id", "document_id", "client_id", "competence_id", "template_id", "template_version", "status", "objects"],
      "properties": {
        "job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["requested", "running", "review_required", "completed", "failed", "cancelled"] },
        "review_status": { "type": "string", "enum": ["not_required", "pending", "approved", "corrected", "rejected"] },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/ExtractedObject" } },
        "error_code": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
