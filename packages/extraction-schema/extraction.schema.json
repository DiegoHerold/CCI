{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/extractions/extraction.schema.json",
  "title": "CCI Extraction Result",
  "type": "object",
  "required": ["job_id", "document_id", "client_id", "competence_id", "template_id", "template_version", "status", "objects"],
  "properties": {
    "job_id": {"type": "string"},
    "document_id": {"type": "string"},
    "client_id": {"type": "string"},
    "competence_id": {"type": "string"},
    "template_id": {"type": "string"},
    "template_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["requested", "running", "review_required", "completed", "failed", "cancelled"]},
    "review_status": {"type": "string", "enum": ["not_required", "pending", "approved", "corrected", "rejected"]},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/ExtractedObject"}},
    "error_code": {"type": ["string", "null"]}
  },
  "$defs": {
    "ExtractedFieldValue": {"type": "object", "required": ["path", "raw_value", "normalized_value", "value_type", "confidence", "evidence_ids"], "properties": {"path": {"type": "string"}, "raw_value": true, "normalized_value": true, "value_type": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}, "additionalProperties": false},
    "ExtractedObject": {"type": "object", "required": ["object_path", "fields"], "properties": {"object_path": {"type": "string"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/ExtractedFieldValue"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
