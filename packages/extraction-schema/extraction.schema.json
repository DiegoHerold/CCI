{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/extractions/extraction.schema.json",
  "title": "CCI Extraction Contracts",
  "oneOf": [
    { "$ref": "#/$defs/ExtractionJob" },
    { "$ref": "#/$defs/ExtractorWorkerInput" },
    { "$ref": "#/$defs/ExtractorWorkerOutput" },
    { "$ref": "#/$defs/RawExtractedField" },
    { "$ref": "#/$defs/RawExtractedObject" },
    { "$ref": "#/$defs/ExtractionRuleExecutionResult" },
    { "$ref": "#/$defs/ExtractedArrayItem" },
    { "$ref": "#/$defs/NormalizationRun" },
    { "$ref": "#/$defs/ExtractionResult" }
  ],
  "$defs": {
    "ExtractionJobStatus": {
      "type": "string",
      "enum": ["pending", "queued", "starting", "running", "waiting_worker", "worker_running", "completed", "failed", "cancelled", "retrying", "requires_review"]
    },
    "ExtractionFieldStatus": {
      "type": "string",
      "enum": ["extracted", "not_found", "ambiguous", "failed", "partial"]
    },
    "ExtractionWorkerStatus": {
      "type": "string",
      "enum": ["completed", "completed_with_warnings", "failed", "unsupported"]
    },
    "ExtractionResultStatus": {
      "type": "string",
      "enum": ["completed", "completed_with_warnings", "requires_review", "failed"]
    },
    "ExtractedFieldStatus": {
      "type": "string",
      "enum": ["normalized", "not_found", "normalization_failed", "low_confidence", "ambiguous", "evidence_missing", "requires_review", "approved", "rejected", "corrected"]
    },
    "NormalizationStatus": {
      "type": "string",
      "enum": ["started", "completed", "failed"]
    },
    "ExtractionJob": {
      "type": "object",
      "required": ["extraction_job_id", "document_id", "client_id", "competence_id", "template_id", "template_version_id", "file_format", "status", "attempt_count", "max_attempts"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version_id": { "type": "string" },
        "matching_run_id": { "type": ["string", "null"] },
        "file_format": { "type": "string" },
        "status": { "$ref": "#/$defs/ExtractionJobStatus" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "workflow_id": { "type": ["string", "null"] },
        "workflow_run_id": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionRequest": {
      "type": "object",
      "properties": {
        "force_reprocess": { "type": "boolean", "default": false },
        "matching_run_id": { "type": ["string", "null"] },
        "template_id": { "type": ["string", "null"] },
        "template_version_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionAttempt": {
      "type": "object",
      "required": ["attempt_id", "extraction_job_id", "attempt_number", "status"],
      "properties": {
        "attempt_id": { "type": "string" },
        "extraction_job_id": { "type": "string" },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "worker_type": { "type": ["string", "null"] },
        "worker_name": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionArtifact": {
      "type": "object",
      "required": ["artifact_id", "extraction_job_id", "document_id", "artifact_type", "storage_bucket", "storage_key"],
      "properties": {
        "artifact_id": { "type": "string" },
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "artifact_type": { "type": "string", "enum": ["worker_raw_output", "workflow_log", "debug_payload"] },
        "storage_bucket": { "type": "string" },
        "storage_key": { "type": "string" },
        "content_hash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionWorkflowInput": {
      "type": "object",
      "required": ["extraction_job_id", "document_id", "client_id", "competence_id", "template_id", "template_version_id", "file_format"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version_id": { "type": "string" },
        "file_format": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ExtractionWorkflowOutput": {
      "type": "object",
      "required": ["extraction_job_id", "status"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "status": { "$ref": "#/$defs/ExtractionJobStatus" },
        "artifact_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractorWorkerInput": {
      "type": "object",
      "required": ["extraction_job_id", "document", "preview", "template"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "correlation_id": { "type": ["string", "null"] },
        "document": {
          "type": "object",
          "required": ["document_id", "file_format"],
          "properties": {
            "document_id": { "type": "string" },
            "client_id": { "type": ["string", "null"] },
            "competence_id": { "type": ["string", "null"] },
            "file_format": { "type": "string" },
            "original_filename": { "type": ["string", "null"] },
            "storage_bucket": { "type": ["string", "null"] },
            "storage_key": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "preview": {
          "type": "object",
          "properties": {
            "preview_id": { "type": ["string", "null"] },
            "storage_bucket": { "type": ["string", "null"] },
            "storage_key": { "type": ["string", "null"] },
            "preview_json": { "type": ["object", "null"] },
            "preview": { "type": ["object", "null"] }
          },
          "additionalProperties": false
        },
        "template": {
          "type": "object",
          "required": ["template_id", "template_version_id", "file_format", "fields", "extraction_rules"],
          "properties": {
            "template_id": { "type": "string" },
            "template_version_id": { "type": "string" },
            "version_number": { "type": ["integer", "null"], "minimum": 1 },
            "file_format": { "type": "string" },
            "structure_type": { "type": ["string", "null"] },
            "fields": { "type": "array", "items": { "type": "object" } },
            "extraction_rules": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        },
        "options": { "type": "object" }
      },
      "additionalProperties": false
    },
    "ExtractorWorkerOutput": {
      "type": "object",
      "required": ["extraction_job_id", "status", "raw_output", "warnings", "errors"],
      "properties": {
        "extraction_job_id": { "type": "string" },
        "status": { "$ref": "#/$defs/ExtractionWorkerStatus" },
        "raw_output": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ExtractionWarning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "field_path": { "type": ["string", "null"] },
        "rule_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractionError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "field_path": { "type": ["string", "null"] },
        "rule_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "RawExtractedField": {
      "type": "object",
      "required": ["field_path", "confidence", "status"],
      "properties": {
        "field_id": { "type": ["string", "null"] },
        "field_path": { "type": "string" },
        "raw_value": true,
        "data_type": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/ExtractionFieldStatus" },
        "evidence": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "RawExtractedArrayItem": {
      "type": "object",
      "required": ["index", "values"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "values": { "type": "object" }
      },
      "additionalProperties": false
    },
    "RawExtractedArray": {
      "type": "object",
      "required": ["field_path", "field_type", "items"],
      "properties": {
        "field_path": { "type": "string" },
        "field_type": { "const": "array" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/RawExtractedArrayItem" } }
      },
      "additionalProperties": false
    },
    "RawExtractedObject": {
      "type": "object",
      "required": ["field_path", "field_type"],
      "properties": {
        "field_path": { "type": "string" },
        "field_type": { "type": "string" },
        "value": { "type": ["object", "null"] },
        "items": { "type": ["array", "null"], "items": { "$ref": "#/$defs/RawExtractedArrayItem" } }
      },
      "additionalProperties": false
    },
    "ExtractionRuleExecutionResult": {
      "type": "object",
      "required": ["rule_id", "strategy", "status"],
      "properties": {
        "rule_id": { "type": "string" },
        "strategy": { "type": "string" },
        "field_path": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/ExtractionFieldStatus" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/ExtractionWarning" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/ExtractionError" } }
      },
      "additionalProperties": false
    },
    "ExtractionRetryPolicy": {
      "type": "object",
      "required": ["max_attempts", "initial_interval_seconds", "backoff_coefficient", "max_interval_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "initial_interval_seconds": { "type": "integer", "minimum": 1 },
        "backoff_coefficient": { "type": "number", "minimum": 1 },
        "max_interval_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "ExtractedFieldValue": {
      "type": "object",
      "required": ["path", "raw_value", "normalized_value", "value_type", "confidence", "status", "evidence_ids"],
      "properties": {
        "field_value_id": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "raw_value": true,
        "normalized_value": true,
        "display_value": { "type": ["string", "null"] },
        "value_type": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/ExtractedFieldStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "ExtractedObject": {
      "type": "object",
      "required": ["object_path", "fields"],
      "properties": {
        "object_path": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ExtractedFieldValue" } }
      },
      "additionalProperties": false
    },
    "ExtractionResult": {
      "type": "object",
      "required": ["job_id", "document_id", "client_id", "competence_id", "template_id", "status", "objects"],
      "properties": {
        "extraction_result_id": { "type": ["string", "null"] },
        "job_id": { "type": "string" },
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "template_id": { "type": "string" },
        "template_version_id": { "type": ["string", "null"] },
        "template_version": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "$ref": "#/$defs/ExtractionResultStatus" },
        "field_count": { "type": "integer", "minimum": 0 },
        "normalized_count": { "type": "integer", "minimum": 0 },
        "requires_review_count": { "type": "integer", "minimum": 0 },
        "review_status": { "type": "string", "enum": ["not_required", "pending", "approved", "corrected", "rejected"] },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/ExtractedObject" } },
        "error_code": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractedArrayItem": {
      "type": "object",
      "required": ["array_field_path", "item_index", "status", "confidence"],
      "properties": {
        "array_item_id": { "type": ["string", "null"] },
        "array_field_path": { "type": "string" },
        "item_index": { "type": "integer", "minimum": 0 },
        "status": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "NormalizationRun": {
      "type": "object",
      "required": ["extraction_job_id", "status"],
      "properties": {
        "normalization_run_id": { "type": ["string", "null"] },
        "extraction_job_id": { "type": "string" },
        "extraction_result_id": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/NormalizationStatus" },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "FieldCorrectionRequest": {
      "type": "object",
      "required": ["raw_value"],
      "properties": {
        "raw_value": true,
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "FieldReviewRequest": {
      "type": "object",
      "properties": {
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExtractedFieldReview": {
      "type": "object",
      "required": ["extraction_result_id", "field_value_id", "action", "previous_status", "reviewed_by"],
      "properties": {
        "review_id": { "type": ["string", "null"] },
        "extraction_result_id": { "type": "string" },
        "field_value_id": { "type": "string" },
        "action": { "type": "string" },
        "previous_status": { "type": "string" },
        "reason": { "type": ["string", "null"] },
        "reviewed_by": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
