{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/documents/upload.schema.json",
  "title": "CCI Document Upload Contracts",
  "oneOf": [
    { "$ref": "#/$defs/UploadDocumentRequest" },
    { "$ref": "#/$defs/UploadDocumentResponse" },
    { "$ref": "#/$defs/UploadZipResponse" },
    { "$ref": "#/$defs/DocumentListItem" },
    { "$ref": "#/$defs/DocumentUploadBatch" }
  ],
  "$defs": {
    "DocumentStatus": {
      "type": "string",
      "enum": [
        "uploaded",
        "duplicate",
        "rejected",
        "storage_failed",
        "preview_pending",
        "preview_ready",
        "template_pending",
        "template_matched",
        "template_not_found",
        "extraction_pending",
        "extracted",
        "review_pending",
        "approved",
        "failed"
      ]
    },
    "FileFormat": {
      "type": "string",
      "enum": ["PDF", "EXCEL", "CSV", "TXT", "DOCX", "XML", "ZIP"]
    },
    "UploadDocumentRequest": {
      "type": "object",
      "required": ["kind", "client_id", "competence_id", "filename"],
      "properties": {
        "kind": { "const": "upload_document_request" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "filename": { "type": "string" },
        "content_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "UploadDocumentResponse": {
      "type": "object",
      "required": [
        "document_id",
        "client_id",
        "competence_id",
        "original_filename",
        "file_format",
        "content_hash",
        "status",
        "is_duplicate"
      ],
      "properties": {
        "document_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "original_filename": { "type": "string" },
        "stored_filename": { "type": ["string", "null"] },
        "file_extension": { "type": ["string", "null"] },
        "file_format": { "$ref": "#/$defs/FileFormat" },
        "mime_type": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "content_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "storage_bucket": { "type": ["string", "null"] },
        "storage_key": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/DocumentStatus" },
        "is_duplicate": { "type": "boolean" },
        "duplicate_of_document_id": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "DocumentListItem": {
      "$ref": "#/$defs/UploadDocumentResponse"
    },
    "ZipError": {
      "type": "object",
      "required": ["filename", "reason"],
      "properties": {
        "filename": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DocumentUploadBatch": {
      "type": "object",
      "required": [
        "batch_id",
        "client_id",
        "competence_id",
        "total_files",
        "created",
        "duplicates",
        "rejected"
      ],
      "properties": {
        "batch_id": { "type": "string" },
        "client_id": { "type": "string" },
        "competence_id": { "type": "string" },
        "total_files": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "UploadZipResponse": {
      "allOf": [
        { "$ref": "#/$defs/DocumentUploadBatch" },
        {
          "type": "object",
          "required": ["documents", "errors"],
          "properties": {
            "documents": {
              "type": "array",
              "items": { "$ref": "#/$defs/UploadDocumentResponse" }
            },
            "errors": {
              "type": "array",
              "items": { "$ref": "#/$defs/ZipError" }
            }
          }
        }
      ]
    }
  }
}
