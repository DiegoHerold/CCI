{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/documents/document.schema.json",
  "title": "CCI Document",
  "type": "object",
  "required": ["document_id", "client_id", "competence_id", "filename", "original_filename", "extension", "mime_type", "size_bytes", "sha256_hash", "storage_bucket", "storage_key", "document_type", "status", "created_at", "updated_at", "metadata"],
  "properties": {
    "document_id": { "type": "string" },
    "client_id": { "type": "string" },
    "competence_id": { "type": "string" },
    "filename": { "type": "string" },
    "original_filename": { "type": "string" },
    "extension": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },
    "mime_type": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "storage_bucket": { "type": "string" },
    "storage_key": { "type": "string" },
    "document_type": {
      "type": "string",
      "enum": ["balancete", "guia_inss", "guia_fgts", "folha_pagamento", "relatorio_fiscal", "relatorio_contabil", "extrato", "outro", "desconhecido"]
    },
    "status": {
      "type": "string",
      "enum": ["imported", "classified", "ambiguous", "missing", "confirmed", "rejected", "extracted", "error"]
    },
    "classification_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
