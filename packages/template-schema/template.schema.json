{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/templates/template.schema.json",
  "title": "CCI Template",
  "type": "object",
  "required": ["template_id", "name", "category_id", "file_format", "structure_type", "status"],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "category_id": {"type": "string", "minLength": 1},
    "file_format": {"type": "string", "enum": ["PDF", "XLSX", "XLS", "CSV", "TXT", "DOCX", "XML", "IMAGE"]},
    "structure_type": {"type": "string", "enum": ["text", "table", "hierarchical", "form", "mixed", "unknown"]},
    "status": {"type": "string", "enum": ["draft", "active", "inactive", "archived"]},
    "active_version_id": {"type": ["string", "null"]},
    "category": {"$ref": "#/$defs/TemplateCategory"},
    "identification_signals": {"type": "array", "items": {"$ref": "#/$defs/IdentificationSignal"}},
    "versions": {"type": "array", "items": {"$ref": "#/$defs/TemplateVersion"}}
  },
  "$defs": {
    "TemplateCategory": {
      "type": "object",
      "required": ["id", "name", "slug", "status"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "slug": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "IdentificationSignal": {
      "type": "object",
      "required": ["signal_type", "weight", "value", "required", "negative"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "template_id": {"type": ["string", "null"]},
        "signal_type": {"type": "string", "enum": ["contains_text", "contains_any_text", "contains_all_text", "not_contains_text", "regex", "file_format", "sheet_name", "column_header", "table_header", "page_count_range", "has_cnpj", "has_date", "has_currency_values", "structure_hint"]},
        "weight": {"type": "number", "minimum": 0, "maximum": 100},
        "value": {"type": "string"},
        "required": {"type": "boolean"},
        "negative": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "DocumentProfile": {
      "type": "object",
      "required": ["document_id", "file_format", "requires_ocr", "detected_keywords", "structure_hints"],
      "properties": {
        "document_id": {"type": "string"},
        "client_id": {"type": ["string", "null"]},
        "competence_id": {"type": ["string", "null"]},
        "file_format": {"type": "string", "enum": ["PDF", "XLSX", "XLS", "CSV", "TXT", "DOCX", "XML", "IMAGE"]},
        "mime_type": {"type": ["string", "null"]},
        "original_filename": {"type": ["string", "null"]},
        "page_count": {"type": "integer", "minimum": 0},
        "sheet_count": {"type": "integer", "minimum": 0},
        "requires_ocr": {"type": "boolean"},
        "text_sample": {"type": "string"},
        "normalized_text_sample": {"type": "string"},
        "detected_keywords": {"type": "array", "items": {"type": "string"}},
        "detected_regex_patterns": {"type": "array", "items": {"type": "string"}},
        "has_cnpj": {"type": "boolean"},
        "has_dates": {"type": "boolean"},
        "has_currency_values": {"type": "boolean"},
        "has_tables": {"type": "boolean"},
        "structure_hints": {"type": "array", "items": {"type": "string"}},
        "sheet_names": {"type": "array", "items": {"type": "string"}},
        "detected_headers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "TemplateMatchingRequest": {
      "type": "object",
      "properties": {
        "force_reprocess": {"type": "boolean", "default": false},
        "category_hint": {"type": ["string", "null"]},
        "max_candidates": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}
      },
      "additionalProperties": false
    },
    "TemplateMatchingCandidate": {
      "type": "object",
      "required": ["template_id", "score", "rank_position", "matched_signals", "missing_required_signals", "negative_matches", "score_details"],
      "properties": {
        "template_id": {"type": "string"},
        "template_version_id": {"type": ["string", "null"]},
        "category_id": {"type": ["string", "null"]},
        "template_name": {"type": ["string", "null"]},
        "category_name": {"type": ["string", "null"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "rank_position": {"type": "integer", "minimum": 1},
        "matched_signals": {"type": "array", "items": {"type": "string"}},
        "missing_required_signals": {"type": "array", "items": {"type": "string"}},
        "negative_matches": {"type": "array", "items": {"type": "string"}},
        "score_details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "TemplateMatchingResult": {
      "type": "object",
      "required": ["matching_run_id", "document_id", "status", "confidence", "decision_reason", "manual_override", "candidates"],
      "properties": {
        "matching_run_id": {"type": "string"},
        "document_id": {"type": "string"},
        "status": {"type": "string", "enum": ["matched", "not_found", "ambiguous", "failed"]},
        "matched_template_id": {"type": ["string", "null"]},
        "matched_template_version_id": {"type": ["string", "null"]},
        "matched_category_id": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_reason": {"type": "string"},
        "manual_override": {"type": "boolean"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/TemplateMatchingCandidate"}}
      },
      "additionalProperties": false
    },
    "TemplateVersion": {
      "type": "object",
      "required": ["id", "template_id", "version_number", "status", "snapshot"],
      "properties": {
        "id": {"type": "string"},
        "template_id": {"type": "string"},
        "version_number": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["draft", "published", "archived"]},
        "snapshot": {"type": "object"}
      },
      "additionalProperties": false
    },
    "ExtractionRule": {
      "type": "object",
      "required": ["field_id", "strategy", "config"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "template_id": {"type": ["string", "null"]},
        "template_version_id": {"type": ["string", "null"]},
        "field_id": {"type": "string"},
        "rule_type": {"type": ["string", "null"]},
        "strategy": {"type": "string", "enum": ["find_near_label", "fixed_bbox", "pdf_area_table", "pdf_column_by_x_position", "hierarchical_lines", "excel_cell_address", "excel_column_by_header", "excel_range_table", "excel_sheet_by_name", "regex_from_text"]},
        "config": {"type": "object"},
        "confidence_hint": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "created_from_annotation_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "TemplateBuilderState": {
      "type": "object",
      "required": ["template", "fields", "annotations", "extraction_rules", "identification_signals"],
      "properties": {
        "template": {"$ref": "#"},
        "active_version": {"anyOf": [{"$ref": "#/$defs/TemplateVersion"}, {"type": "null"}]},
        "draft_version": {"anyOf": [{"$ref": "#/$defs/TemplateVersion"}, {"type": "null"}]},
        "fields": {"type": "array", "items": {"type": "object"}},
        "annotations": {"type": "array", "items": {"type": "object"}},
        "extraction_rules": {"type": "array", "items": {"$ref": "#/$defs/ExtractionRule"}},
        "identification_signals": {"type": "array", "items": {"$ref": "#/$defs/IdentificationSignal"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
