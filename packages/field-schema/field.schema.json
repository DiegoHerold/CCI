{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/fields/field.schema.json",
  "title": "CCI Field Definition",
  "type": "object",
  "required": ["field_id", "path", "label", "field_type", "required"],
  "properties": {
    "field_id": {"type": "string"},
    "path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$"},
    "label": {"type": "string", "minLength": 1},
    "field_type": {"type": "string", "enum": ["string", "integer", "decimal", "money", "boolean", "date", "datetime", "object", "array", "table", "calculated"]},
    "required": {"type": "boolean"},
    "children": {"type": "array", "items": {"$ref": "#"}},
    "formula": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
