{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/fields/field.schema.json",
  "title": "CCI Field Definition",
  "type": "object",
  "required": ["id", "template_id", "field_path", "label", "field_type", "is_required", "is_repeated", "is_object", "is_array", "order_index"],
  "properties": {
    "id": {"type": "string"},
    "template_id": {"type": "string"},
    "parent_field_id": {"type": ["string", "null"]},
    "field_path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "field_type": {"type": "string", "enum": ["text", "number", "money", "date", "month", "cnpj", "cpf", "boolean", "percentage", "account_code", "object", "array", "table", "calculated", "unknown"]},
    "is_required": {"type": "boolean"},
    "is_repeated": {"type": "boolean"},
    "is_object": {"type": "boolean"},
    "is_array": {"type": "boolean"},
    "order_index": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "FieldTreeNode": {
      "type": "object",
      "required": ["key", "label", "path", "children"],
      "properties": {
        "key": {"type": "string"},
        "label": {"type": "string"},
        "path": {"type": "string"},
        "field": {"anyOf": [{"$ref": "#"}, {"type": "null"}]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/FieldTreeNode"}}
      },
      "additionalProperties": false
    },
    "FieldMappingStatus": {
      "type": "string",
      "enum": ["unmapped", "mapped", "partial"]
    }
  },
  "additionalProperties": false
}
