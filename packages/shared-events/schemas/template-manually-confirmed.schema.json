{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/events/template-manually-confirmed.schema.json",
  "title": "TemplateManuallyConfirmed",
  "allOf": [
    { "$ref": "event-envelope.schema.json" },
    {
      "properties": {
        "event_type": { "const": "TemplateManuallyConfirmed" },
        "payload": {
          "type": "object",
          "required": ["document_id", "template_id", "template_version_id", "category_id", "confidence", "matching_run_id", "reason"],
          "properties": {
            "document_id": { "type": "string" },
            "client_id": { "type": ["string", "null"] },
            "competence_id": { "type": ["string", "null"] },
            "template_id": { "type": "string" },
            "template_version_id": { "type": "string" },
            "category_id": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "matching_run_id": { "type": "string" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
