{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cci.local/schemas/shared/primitives.schema.json",
  "title": "CCI Shared Primitives",
  "$defs": {
    "UUID": {"type": "string", "format": "uuid"},
    "Timestamp": {"type": "string", "format": "date-time"},
    "Money": {"type": "object", "required": ["amount", "currency"], "properties": {"amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}, "additionalProperties": false},
    "DateRange": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}, "additionalProperties": false},
    "ConfidenceScore": {"type": "number", "minimum": 0, "maximum": 1},
    "Pagination": {"type": "object", "required": ["page", "limit", "total"], "properties": {"page": {"type": "integer", "minimum": 1}, "limit": {"type": "integer", "minimum": 1}, "total": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  }
}
