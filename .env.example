APP_ENV=development
APP_NAME=cci-platform

# PostgreSQL da aplicação
POSTGRES_HOST=postgres-app
POSTGRES_PORT=5432
POSTGRES_USER=cci
POSTGRES_PASSWORD=cci_password
POSTGRES_DB=cci_platform

# PostgreSQL do Temporal
TEMPORAL_POSTGRES_HOST=temporal-postgres
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_password
TEMPORAL_POSTGRES_DB=temporal

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cci
RABBITMQ_PASSWORD=cci_password

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=cci_minio
MINIO_SECRET_KEY=cci_minio_password
MINIO_BUCKET_RAW_DOCUMENTS=raw-documents
MINIO_BUCKET_PROCESSED_DOCUMENTS=processed-documents
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_EVIDENCES=evidences

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_UI_PORT=8233

# BFF
SERVICE_NAME=bff
LOG_LEVEL=INFO
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_SERVICE_URL=http://identity-service:8101
CLIENT_SERVICE_URL=http://client-service:8102
CONFERENCE_MODEL_SERVICE_URL=http://conference-model-service:8103
SCHEDULE_SERVICE_URL=http://schedule-service:8104
DOCUMENT_INGESTION_SERVICE_URL=http://document-ingestion-service:8110
DOCUMENT_CLASSIFICATION_SERVICE_URL=http://document-classification-service:8111
VARIABLE_REGISTRY_SERVICE_URL=http://variable-registry-service:8120
RULE_SERVICE_URL=http://rule-service:8130
EXECUTION_CONTROL_SERVICE_URL=http://execution-control-service:8140
RESULT_SERVICE_URL=http://result-service:8141
AUDIT_SERVICE_URL=http://audit-service:8150
REPORT_SERVICE_URL=http://report-service:8160
LOG_SERVICE_URL=http://log-service:8170
