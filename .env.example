APP_ENV=development
APP_NAME=cci-platform
LOG_LEVEL=INFO

# Web/BFF
WEB_APP_URL=http://localhost:3000
BFF_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BFF_URL=http://localhost:8000/api/v1

# PostgreSQL da aplicação
POSTGRES_HOST=postgres-app
POSTGRES_PORT=5432
POSTGRES_USER=cci
POSTGRES_PASSWORD=cci_password
POSTGRES_DB=cci_platform
DATABASE_URL=postgresql+psycopg://cci:cci_password@postgres-app:5432/cci_platform

# PostgreSQL do Temporal
TEMPORAL_POSTGRES_HOST=temporal-postgres
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_password
TEMPORAL_POSTGRES_DB=temporal

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cci
RABBITMQ_PASSWORD=cci_password
RABBITMQ_URL=amqp://cci:cci_password@rabbitmq:5672/

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=cci_minio
MINIO_SECRET_KEY=cci_minio_password
MINIO_BUCKET_RAW_DOCUMENTS=raw-documents
MINIO_BUCKET_PROCESSED_DOCUMENTS=processed-documents
MINIO_BUCKET_REPORTS=cci-reports
MINIO_BUCKET_EVIDENCES=evidences
# Compatibilidade com nomes antigos e buckets canônicos.
MINIO_BUCKET_REPORTS_LEGACY=reports
MINIO_BUCKET_DOCUMENTS_ORIGINAL=cci-documents-original
MINIO_BUCKET_DOCUMENTS_PREVIEW=cci-documents-preview
MINIO_BUCKET_EXTRACTION_ARTIFACTS=cci-extraction-artifacts
MINIO_BUCKET_TEMP=cci-temp

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=cci-development

# BFF
SERVICE_NAME=bff
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_SERVICE_URL=http://identity-service:8101
CLIENT_SERVICE_URL=http://client-service:8102
DOCUMENT_SERVICE_URL=http://document-service:8110
TEMPLATE_SERVICE_URL=http://template-service:8120
IDENTITY_TIMEOUT_SECONDS=5
CLIENT_SERVICE_TIMEOUT_SECONDS=5
TEMPLATE_SERVICE_TIMEOUT_SECONDS=5
DEFAULT_COMPETENCE_FOLDER_PATTERN={{YYYY}}/{{MM}}
CONFERENCE_MODEL_SERVICE_URL=http://conference-model-service:8103
SCHEDULE_SERVICE_URL=http://schedule-service:8104
DOCUMENT_INGESTION_SERVICE_URL=http://document-ingestion-service:8110
DOCUMENT_CLASSIFICATION_SERVICE_URL=http://document-classification-service:8111
VARIABLE_REGISTRY_SERVICE_URL=http://variable-registry-service:8120
RULE_SERVICE_URL=http://rule-service:8130
EXECUTION_CONTROL_SERVICE_URL=http://execution-control-service:8140
RESULT_SERVICE_URL=http://result-service:8141
AUDIT_SERVICE_URL=http://audit-service:8150
REPORT_SERVICE_URL=http://report-service:8160
LOG_SERVICE_URL=http://log-service:8170

# Document Service
DOCUMENT_MAX_FILE_SIZE_MB=50
DOCUMENT_MAX_ZIP_SIZE_MB=200
DOCUMENT_MAX_FILES_PER_ZIP=100
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.txt,.docx,.xml,.zip
PARSER_WORKER_URL=http://parser-worker:8121
PARSER_WORKER_TIMEOUT_SECONDS=60

# Template Service
TEMPLATE_SERVICE_PORT=8120
TEMPLATE_DATABASE_SCHEMA=template
TEMPLATE_MAX_SELECTION_PAYLOAD_KB=256
TEMPLATE_MAX_RULE_CONFIG_KB=128
TEMPLATE_MATCH_MIN_CONFIDENCE=0.75
TEMPLATE_MATCH_AUTO_ACCEPT_CONFIDENCE=0.90
TEMPLATE_MATCH_AMBIGUITY_DELTA=0.08
TEMPLATE_MATCH_MAX_CANDIDATES=10
TEMPLATE_PROFILE_TEXT_SAMPLE_LIMIT=5000
TEMPLATE_PROFILE_MAX_KEYWORDS=200

# Parser Worker
PARSER_WORKER_CONCURRENCY=2
PARSER_MAX_FILE_SIZE_MB=100
PARSER_PREVIEW_MAX_JSON_SIZE_MB=25

# Identity Service — preencha antes de iniciar o serviço
# JWT_SECRET/JWT_ALGORITHM são aliases-alvo; o Identity atual usa os segredos
# de access/refresh separados logo abaixo.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_MAX_AGE=604800
SEED_ADMIN_NAME=Administrador CCI
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
PROMETHEUS_PORT=9090
