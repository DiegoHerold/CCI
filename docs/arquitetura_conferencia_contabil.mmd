flowchart TB

  subgraph Apps["Apps"]
    User["Usuário"]
    Web["Web App\nNext.js em apps/web\n(alvo lógico: web-app)"]
    BFF["BFF\nPorta de entrada da Web"]
  end

  subgraph Services["Services: domínios principais"]
    Identity["Identity Service\nusuários, auth, roles,\npermissões, convites, sessões"]
    Client["Client Service\nclientes, competências,\nvínculos, permissões por cliente,\npasta padrão"]
    Document["Document Service\nupload, ZIP, metadados,\nhash, storage, status,\npreview estruturado"]
    Template["Template Service\ntemplates, categorias,\ncampos/objetos, anotações,\nmatching, versões"]
    Extraction["Extraction Service\njobs, Temporal,\nresultados, evidências,\nnormalização, revisão"]
    Rule["Rule Service\nDSL, operadores, fórmulas,\nRule Builder futuro,\nsimulação, versões"]
    Conference["Conference Service\nmodelos, documentos esperados,\nrule sets, execuções,\nresultado, auditoria,\ntimeline, agenda"]
    Report["Report Service\nPDF, Excel,\ndocumentos anotados,\nexportações"]
  end

  subgraph Workers["Workers: tarefas pesadas"]
    ParserWorker["parser-worker\npreview PDF/Excel"]
    PdfWorker["pdf-extractor-worker"]
    ExcelWorker["excel-extractor-worker"]
    OcrWorker["ocr-worker"]
    AiWorker["ai-extraction-worker\nJSON + evidência + confiança\n+ revisão obrigatória"]
    RuleWorker["rule-worker"]
    ReportWorker["report-worker"]
  end

  subgraph Packages["Packages: contratos compartilhados"]
    SharedTypes["shared-types"]
    SharedEvents["shared-events"]
    SharedAuth["shared-auth"]
    DocSchema["document-schema"]
    TemplateSchema["template-schema"]
    AnnotationSchema["annotation-schema"]
    ExtractionSchema["extraction-schema"]
    EvidenceSchema["evidence-schema"]
    RuleSchema["rule-schema"]
    RuleEngine["rule-engine"]
  end

  subgraph Infra["Infra: ambiente e plataforma"]
    Postgres["PostgreSQL\nschemas por domínio"]
    Redis["Redis\ncache, locks, estados transitórios"]
    Bus["RabbitMQ ou NATS\neventos oficiais"]
    Minio["MinIO / S3\noriginais, previews,\nartefatos, relatórios"]
    Temporal["Temporal\nworkflows duráveis"]
    Gateway["Gateway\nNginx ou Traefik"]
    Observability["Observabilidade\nOpenTelemetry, Sentry,\nPrometheus, Grafana"]
  end

  User --> Web
  Web -->|"REST/HTTPS"| BFF

  BFF -->|"REST transição / gRPC alvo"| Identity
  BFF -->|"REST transição / gRPC alvo"| Client
  BFF -->|"REST transição / gRPC alvo"| Document
  BFF -->|"REST transição / gRPC alvo"| Template
  BFF -->|"REST transição / gRPC alvo"| Extraction
  BFF -->|"REST transição / gRPC alvo"| Rule
  BFF -->|"REST transição / gRPC alvo"| Conference
  BFF -->|"REST transição / gRPC alvo"| Report

  Document --> Minio
  Document --> ParserWorker
  ParserWorker --> Minio
  ParserWorker -. "DocumentPreviewGenerated" .-> Bus

  Document -. "DocumentUploaded / DocumentStored" .-> Bus
  Template -. "TemplateMatched / TemplateAmbiguous" .-> Bus
  Extraction -. "ExtractionRequested" .-> Bus
  Conference -. "ConferenceStarted / ConferenceCompleted" .-> Bus
  Report -. "ReportRequested / ReportGenerated" .-> Bus

  Template --> DocSchema
  Template --> TemplateSchema
  Template --> AnnotationSchema
  Extraction --> ExtractionSchema
  Extraction --> EvidenceSchema
  Rule --> RuleSchema
  Rule --> RuleEngine
  Identity --> SharedAuth
  Services --> SharedTypes
  Services --> SharedEvents

  Extraction --> Temporal
  Temporal --> PdfWorker
  Temporal --> ExcelWorker
  Temporal --> OcrWorker
  Temporal --> AiWorker
  Temporal --> RuleWorker
  Temporal --> ReportWorker

  PdfWorker --> Extraction
  ExcelWorker --> Extraction
  OcrWorker --> Extraction
  AiWorker --> Extraction
  RuleWorker --> Conference
  ReportWorker --> Report

  RuleWorker --> RuleEngine
  Report --> Minio
  ReportWorker --> Minio

  Identity --> Postgres
  Client --> Postgres
  Document --> Postgres
  Template --> Postgres
  Extraction --> Postgres
  Rule --> Postgres
  Conference --> Postgres
  Report --> Postgres

  BFF --> Redis
  Services --> Redis
  Services -. "eventos de domínio" .-> Bus
  Workers -. "status e resultados" .-> Bus

  Apps --> Observability
  Services --> Observability
  Workers --> Observability
